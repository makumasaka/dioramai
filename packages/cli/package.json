{
  "name": "dioramai",
  "version": "0.2.2",
  "description": "Local-first CLI and bridge for Dioramai runtime sync in React Three Fiber repos.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "dioramai": "dist/index.js",
    "diorama": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkumasaka/dioramai.git"
  },
  "homepage": "https://dioramai.design",
  "bugs": {
    "url": "https://github.com/mkumasaka/dioramai/issues"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts dev",
    "init": "tsx src/index.ts init",
    "doctor": "tsx src/index.ts doctor",
    "export": "tsx src/index.ts export",
    "validate": "tsx src/index.ts validate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/build.mjs",
    "build": "npm run typecheck && npm run bundle",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.12.2",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}
