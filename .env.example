# Dioramai local bridge configuration (all optional).
# Copy to .env and uncomment values you want to override.

# Fixed pairing token for browser <-> bridge auth.
# Default: a random token is generated on every bridge start.
#DIORAMAI_BRIDGE_TOKEN=

# Port for the local bridge HTTP server. Default: 7777.
#DIORAMAI_BRIDGE_PORT=7777

# Project root the bridge syncs against. Default: current working directory.
#DIORAMAI_PROJECT_ROOT=

# Comma-separated list of allowed browser origins for CORS.
# Default: empty (any origin allowed; requests still require the pairing token).
#DIORAMAI_ALLOWED_ORIGINS=https://dioramai.design,http://localhost:5173
